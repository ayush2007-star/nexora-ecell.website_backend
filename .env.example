# ==============================================================================
# NEXORA INNOVATION PORTAL - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Project & Server Configuration
APP_NAME=Nexora Innovation Portal
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# MongoDB Database Connection (Replace with your MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=PASTE_HERE_MONGODB_URL
DATABASE_NAME=nexora

# JWT Authentication
SECRET_KEY=nexora-super-secret-jwt-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Frontend URLs for CORS (Comma separated or * for any)
# Example: https://nexora-ecell.vercel.app,http://localhost:5173
FRONTEND_URLS=https://nexora-ecell.vercel.app,http://localhost:5173,http://localhost:3000

# File Upload & Certificate Storage
UPLOAD_FOLDER=app/uploads
CERTIFICATE_FOLDER=app/certificates
MAX_TEAM_MEMBERS=3
MAX_PDF_SIZE_MB=10

# SMTP / Email Configuration (Optional - leave empty if not using email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=Nexora Innovation Portal <your-email@gmail.com>
